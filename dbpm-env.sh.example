#!/usr/bin/env sh
# Copy this file to ~/.config/dbpm/<application>/environments/<environment>.sh
# (or the equivalent XDG_CONFIG_HOME path) and fill in local values. Keep live
# profiles outside application repositories because they may contain
# credentials and must not enter source artifacts.

# Clear every connection form before selecting exactly one below. This makes
# the profile safe to load after a different dbpm target was previously used.
unset DBPM_CONNECT
unset DBPM_CONNECT_NAME
unset DBPM_DB_USER
unset DBPM_DB_PASSWORD
unset DBPM_DB_DSN

export DBPM_SQL_RUNNER="sql"

# Option A: structured database credentials. dbpm composes the Oracle connect
# string from these values, and package runtime scripts inherit them.
export DBPM_DB_USER="application_user"
export DBPM_DB_PASSWORD="application_password"
export DBPM_DB_DSN="tns_alias_or_host/service"

# Option B: raw Oracle connect string. Keep the structured variables unset.
# unset DBPM_DB_USER DBPM_DB_PASSWORD DBPM_DB_DSN
# export DBPM_CONNECT="user/password@tns_alias_or_service"

# Option C: SQLcl saved connection name local to this OS user. Keep the
# structured variables and DBPM_CONNECT unset.
# unset DBPM_DB_USER DBPM_DB_PASSWORD DBPM_DB_DSN
# unset DBPM_CONNECT
# export DBPM_CONNECT_NAME="Development Database (APP_USER)"

# Required for private GitHub Packages.
export DBPM_GITHUB_TOKEN="github_token_with_package_read_access"
export DBPM_GITHUB_USER="github_username"

# Required when publishing package artifacts.
export DBPM_SIGNING_KEY="gpg_key_id_or_fingerprint"
# Required for generic Maven publishing targets.
export DBPM_MAVEN_TOKEN="maven_repository_token"
export DBPM_MAVEN_USER="maven_repository_username"

# Required when publishing metadata to a dbpm registry.
# Keep the full publish-token value outside source control.
export DBPM_REGISTRY_URL="https://registry.dbpm.io"
export DBPM_REGISTRY_TOKEN="registry_publish_token"
# Optional overrides when package.vendor or package.description is absent.
# export DBPM_REGISTRY_PUBLISHER="publisher_name"
# export DBPM_REGISTRY_DESCRIPTION="Package description"

# Local dbpm runtime directories.
export DBPM_CACHE_DIR="./.dbpm-cache"
export DBPM_LOG_DIR="./.dbpm-logs"

# Optional: enable opt-in live database pytest tests.
# export DBPM_RUN_DB_TESTS="1"
